install.packages("pwr")
library(pwr)
pwr.r.test(n = 16, r = .55, sig.level = .05)  # A 的 future r=.55
# 输出 power ≈ .68，说明 32% 概率检不出——C 没检出不稀奇
# 加载必要的包
library(dplyr)
library(boot)
# 1. 提取 OA 组数据（确保列名和 dat_raw 一致！）
oa_dat <- dat_raw %>%
filter(GRUPO == "OA") %>%        # 筛选 OA 组（注意："OA" 的大小写/拼写）
select(VPA, TOT_int) %>%         # 选择 VPA 和 TOT_int 列（列名必须和 dat_raw 完全一致！）
na.omit()                        # 移除含 NA 的行
# 检查数据：查看前几行 + 列名 + 行数
print("OA 组数据的列名：")
print(colnames(oa_dat))  # 必须输出 [1] "VPA" "TOT_int"
print("OA 组数据的行数：")
print(nrow(oa_dat))      # 必须 > 0（否则数据为空）
print("OA 组数据的前 3 行：")
print(head(oa_dat, 3))   # 查看数据是否存在
unique(dat_raw$GRUPO)
# 2. 定义相关性函数（逻辑：计算 VPA 和 TOT_int 的相关系数）
cor_fun <- function(data, i) {
# data 是 oa_dat 的子集（由 boot 自动传入），i 是行索引
cor(data$VPA[i], data$TOT_int[i], use = "complete")
}
# 测试：用 oa_dat 的前 10 行运行 cor_fun（模拟 boot 的调用逻辑）
test_result <- cor_fun(oa_dat, 1:min(10, nrow(oa_dat)))
